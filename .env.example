# Lilipadd site key — create in Lilipadd admin (Site Keys) or run:
#   npm run seed:leannedigital
# in the Lilipadd repo (writes this file automatically).
LILIPADD_SITE_KEY=

# Local dev: point at your Lilipadd API. Production defaults are baked in.
# LILIPADD_SNIPPET_URL=http://localhost:4000/v1/snippet.js
# LILIPADD_PLATFORM_URL=https://app.lilipadd.com/v1/platform.js

# Client portal API / MCP. Leave empty to allow session cookie auth only.
PORTAL_API_KEY=
PORTAL_API_PORT=4174

# Staff login. If password is empty, one is generated on first boot
# and written to data/portal-bootstrap.json (gitignored).
PORTAL_STAFF_EMAIL=gary@leannedigital.com
PORTAL_STAFF_PASSWORD=

# Include reset URLs in the forgot-password API response (local only).
PORTAL_DEV_RESET_LINKS=1

# Contact form. If SMTP is empty, messages are saved to data/contact-inbox.jsonl.
MAIL_TO=leanne@leannedigital.com
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google reCAPTCHA v3. Site key is public; secret stays on the server.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
