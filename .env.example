# Lilipadd — public site key for platform.js ingestion AND analytics read (query key=).
# Create in Lilipadd admin (Site Keys) or run `npm run seed:leannedigital` in Lilipadd.
# This value is public (browser). Never put the private server key here.
LILIPADD_SITE_KEY=

# Lilipadd analytics read (server-to-server). Collection stays in Lilipadd / platform.js.
# LILIPADD_API_KEY is a PRIVATE tenant-bound server key with stats:read.
# It is sent only as Authorization: Bearer — never in the URL, HTML, or platform.js.
# Issue it in Lilipadd: POST /api/t/leannedigital/api-keys
#   { "label": "Leanne Digital analytics", "kind": "server", "scopes": ["stats:read"] }
LILIPADD_API_URL=https://api.lilipadd.com
LILIPADD_API_KEY=

# Client portal HTTP API. Leave empty to allow session cookie auth only.
# Do not reuse this key for ChatGPT/Claude remote MCP.
PORTAL_API_KEY=
PORTAL_API_PORT=4174
# Bind address. Keep 127.0.0.1 unless a TLS reverse proxy is in front.
# PORTAL_BIND=127.0.0.1

# Remote MCP (ChatGPT / Claude over HTTPS). Dedicated credential — never put this
# in HTML, platform.js, or public GPT instructions. Sent as:
#   Authorization: Bearer <REMOTE_MCP_API_KEY>
# Generate a long random token. If unset, POST /mcp returns 503.
# REMOTE_MCP_API_KEY=
# Optional: expose only read tools on the remote endpoint
# REMOTE_MCP_READ_ONLY=1
# REMOTE_MCP_RATE_LIMIT_PER_MIN=60

# Remote MCP OAuth 2.1 (Better Auth). Required for ChatGPT's "OAuth" connector option.
# Issuer and resource must be the public HTTPS URLs clients will call.
# OAUTH_ISSUER=https://leannedigital.com
# OAUTH_RESOURCE=https://leannedigital.com/mcp
# Persistent OAuth DB/keys/sessions. Production should be outside the site tree, e.g.
# /home/leannedigital.com/private/oauth
# OAUTH_DATA_DIR=
# 32+ random bytes. Never commit the real value. Used to sign cookies and JWKS private keys.
# OAUTH_SECRET=
# Staff identity that may approve MCP access. Do not reuse the portal bootstrap password.
# OAUTH_ADMIN_EMAIL=gary@leannedigital.com
# OAUTH_ADMIN_PASSWORD=
# Optional token lifetimes in seconds (defaults: access 900, refresh 2592000)
# OAUTH_ACCESS_TOKEN_TTL=900
# OAUTH_REFRESH_TOKEN_TTL=2592000


# Staff login. If password is empty, one is generated on first boot
# and written to data/portal-bootstrap.json (gitignored).
PORTAL_STAFF_EMAIL=gary@leannedigital.com
PORTAL_STAFF_PASSWORD=

# Include reset URLs in the forgot-password API response (local only).
PORTAL_DEV_RESET_LINKS=1

# Contact form. If SMTP is empty, messages are saved to data/contact-inbox.jsonl.
MAIL_TO=leanne@leannedigital.com
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google reCAPTCHA v3. Site key is public; secret stays on the server.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
